# True: uses fictional data in the local/demo frontend. Set false to read the live /api/search.
VITE_DEMO_MODE=true
# Public share URL of your Google Form, e.g. https://docs.google.com/forms/d/e/.../viewform
VITE_FORM_URL=
# Optional contact/correction form URL (public)
VITE_CORRECTION_URL=

# Vercel function ONLY, never use VITE_ prefix for these:
SHEETS_API_URL=
SHEETS_API_TOKEN=

# Live source: hybrid combines the school snapshot and consenting Form responses.
# Alternatives: official (snapshot only), sheets (Form responses only).
# Set VITE_DEMO_MODE=false to use live API results in the UI.
SEARCH_SOURCE=hybrid
VITE_DATA_SOURCE=hybrid
# Optional server-only snapshot override. Default: local crawl, then server-data/official.json.
OFFICIAL_DATA_PATH=
